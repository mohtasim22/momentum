# Copy to .env and fill in.

# Neon → Connect (branch: dev), pooled URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# A SEPARATE database for `npm run test:integration`. It is wiped on every run.
# Easiest: the same Neon URL with the database name changed, after running
# CREATE DATABASE momentum_test; in the Neon SQL editor.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/momentum_test?sslmode=verify-full"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Where the app runs. Changes to the real domain in production.
BETTER_AUTH_URL="http://localhost:3000"

# Optional. Without a key, invite links are printed to the server console
# (and always shown to the person who sent the invite).
RESEND_API_KEY=""
EMAIL_FROM="Momentum <onboarding@resend.dev>"
